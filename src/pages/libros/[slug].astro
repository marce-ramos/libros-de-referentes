---
import { getCollection, getEntry, getEntries, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BotonAfiliado from "@/components/BotonAfiliado.astro";
import BotonKindle from "@/components/BotonKindle.astro";
import BloqueAudible from "@/components/BloqueAudible.astro";
import PortadaLibro from "@/components/PortadaLibro.astro";
import { SITE } from "@/config";
import { schemaBook, schemaBreadcrumb } from "@/lib/schema";

export async function getStaticPaths() {
  const libros = await getCollection("libros");
  return libros.map((libro) => ({
    params: { slug: libro.id },
    props: { libro },
  }));
}

const { libro } = Astro.props;
const d = libro.data;

// Resolver relaciones (referencias -> entradas reales).
const categoria = await getEntry(d.categoria);
const referentes = await getEntries(d.recomendadoPor);

const { Content } = await render(libro);

const url = new URL(`/libros/${libro.id}`, SITE.url).href;
const query = `${d.titulo} ${d.autorLibro}`;

const jsonLd = [
  schemaBook({
    titulo: d.titulo,
    autorLibro: d.autorLibro,
    portada: d.portada,
    url,
    resumen: d.resumen,
  }),
  schemaBreadcrumb([
    { nombre: "Inicio", url: SITE.url },
    { nombre: categoria.data.nombre, url: new URL(`/categorias/${categoria.id}`, SITE.url).href },
    { nombre: d.titulo, url },
  ]),
];
---

<BaseLayout title={d.titulo} description={d.resumen} type="article" image={d.portada} jsonLd={jsonLd}>
  <nav class="mb-4 text-sm text-slate-500">
    <a href="/" class="hover:underline">Inicio</a> ·
    <a href={`/categorias/${categoria.id}`} class="hover:underline">{categoria.data.nombre}</a>
  </nav>

  <article class="grid gap-8 sm:grid-cols-[200px_1fr]">
    <div>
      <PortadaLibro portada={d.portada} titulo={d.titulo} autorLibro={d.autorLibro} size="full" />
      <div class="mt-4 space-y-2">
        <BotonAfiliado asin={d.asin} query={query} />
        <div><BotonKindle query={query} /></div>
      </div>
    </div>

    <div>
      <h1 class="text-2xl font-bold text-slate-900">{d.titulo}</h1>
      <p class="mt-1 text-slate-500">
        {d.autorLibro}{d.anio ? ` · ${d.anio}` : ""}
      </p>

      <div class="mt-3 flex flex-wrap gap-2">
        {
          referentes.map((r) => (
            <a
              href={`/autores/${r.id}`}
              class="rounded-full bg-[var(--brand)]/10 px-3 py-1 text-sm text-[var(--brand)] hover:bg-[var(--brand)]/20"
            >
              Recomendado por {r.data.nombre}
            </a>
          ))
        }
      </div>

      <BloqueAudible titulo={`«${d.titulo}»`} />

      <div class="prose-contenido mt-2">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
