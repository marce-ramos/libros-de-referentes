---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import LibroEstante from "@/components/LibroEstante.astro";
import TarjetaRecomendado from "@/components/TarjetaRecomendado.astro";
import { SITE } from "@/config";
import { schemaWebSite } from "@/lib/schema";

const categorias = (await getCollection("categorias")).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const libros = await getCollection("libros");
const autores = await getCollection("autores");
const nombreDe = new Map(autores.map((a) => [a.id, a.data.nombre]));

const iconos: Record<string, string> = {
  historia: "🏛️", negocios: "💼", ciencia: "🔬", memorias: "📖", ficcion: "📚",
  psicologia: "🧠", filosofia: "💭", cienciaficcion: "🚀", espiritualidad: "🕊️",
};

function recomendadores(l: (typeof libros)[number]): string[] {
  return l.data.recomendadoPor.map((r) => nombreDe.get(r.id) ?? r.id);
}
function fmtNombres(ns: string[]): string {
  if (ns.length === 1) return ns[0];
  if (ns.length === 2) return `${ns[0]} y ${ns[1]}`;
  return `${ns[0]}, ${ns[1]} y ${ns.length - 2} más`;
}

// Los más recomendados: coincidencia de varios referentes (2+), ranking por cantidad.
const masRecomendados = libros
  .filter((l) => l.data.recomendadoPor.length >= 2)
  .sort(
    (a, b) =>
      b.data.recomendadoPor.length - a.data.recomendadoPor.length ||
      Number(!!b.data.asin) - Number(!!a.data.asin),
  );
const topRecomendados = masRecomendados.slice(0, 6);

// Estantes por categoría (hasta 7 por fila, enriquecidos primero).
const estantes = categorias
  .map((cat) => {
    const deCat = libros
      .filter((l) => l.data.categoria.id === cat.id)
      .sort(
        (a, b) =>
          b.data.recomendadoPor.length - a.data.recomendadoPor.length ||
          Number(!!b.data.asin) - Number(!!a.data.asin) ||
          a.data.titulo.localeCompare(b.data.titulo),
      );
    return { cat, libros: deCat.slice(0, 7), total: deCat.length };
  })
  .filter((e) => e.total > 0);
---

<BaseLayout title={SITE.name} description={SITE.description} bare jsonLd={[schemaWebSite()]}>
  <section
    class="px-4 pb-14 pt-12 text-center"
    style="background: linear-gradient(180deg, #e9e3fb 0%, #f6f3fd 55%, var(--page) 100%);"
  >
    <h1 class="mx-auto max-w-3xl text-4xl font-bold text-[var(--brand-ink)] sm:text-5xl">
      Qué leen los grandes referentes del mundo
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-[var(--muted)]">
      Los libros que recomiendan Bill Gates, Barack Obama, Warren Buffett y más. Elegí tu próxima
      lectura entre las mentes más influyentes.
    </p>
    <a
      href="/autores"
      class="mt-6 inline-block rounded-lg bg-[var(--brand)] px-6 py-3 font-semibold text-white transition hover:bg-[var(--brand-dark)]"
    >
      Explorar referentes
    </a>
  </section>

  <section class="mx-auto max-w-5xl px-4 pt-10">
    <h2 class="text-2xl font-bold text-[var(--brand-ink)]">Los más recomendados</h2>
    <p class="mt-1 mb-6 text-[var(--muted)]">
      Los libros en los que coinciden varios referentes. Cuantos más los eligen, más arriba.
    </p>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        topRecomendados.map((l) => (
          <TarjetaRecomendado
            id={l.id}
            titulo={l.data.titulo}
            autorLibro={l.data.autorLibro}
            portada={l.data.portada}
            count={l.data.recomendadoPor.length}
            recomendadores={fmtNombres(recomendadores(l))}
          />
        ))
      }
    </div>
    {
      masRecomendados.length > topRecomendados.length && (
        <div class="mt-6 text-center">
          <a
            href="/mas-recomendados"
            class="inline-block rounded-lg border border-[var(--brand)] px-5 py-2.5 text-sm font-semibold text-[var(--brand)] transition hover:bg-[var(--brand)] hover:text-white"
          >
            Ver el ranking completo ({masRecomendados.length}) →
          </a>
        </div>
      )
    }
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16 pt-12">
    <h2 class="mb-6 text-2xl font-bold text-[var(--brand-ink)]">Explorá por tema</h2>
    {
      estantes.map((e) => (
        <div class="mb-9">
          <div class="mb-3 flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-[var(--chip-bg)] text-lg">
              {iconos[e.cat.id] ?? "📕"}
            </span>
            <h3 class="text-lg font-semibold text-[var(--brand-ink)]">{e.cat.data.nombre}</h3>
            <a
              href={`/categorias/${e.cat.id}`}
              class="ml-auto text-sm font-medium text-[var(--brand)] hover:underline"
            >
              Ver todos ({e.total})
            </a>
          </div>
          <div class="flex items-start gap-3 overflow-x-auto pb-1">
            {e.libros.map((l) => (
              <LibroEstante
                id={l.id}
                titulo={l.data.titulo}
                autorLibro={l.data.autorLibro}
                portada={l.data.portada}
                count={l.data.recomendadoPor.length}
              />
            ))}
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>
