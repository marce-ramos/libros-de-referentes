---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CardLibro from "@/components/CardLibro.astro";
import { SITE } from "@/config";
import { schemaWebSite } from "@/lib/schema";

const autores = (await getCollection("autores"))
  .filter((a) => a.data.destacado)
  .sort((a, b) => a.data.orden - b.data.orden);

const librosDestacados = (await getCollection("libros")).filter((l) => l.data.destacado);

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 4);
---

<BaseLayout
  title={SITE.name}
  description={SITE.description}
  jsonLd={[schemaWebSite()]}
>
  <section class="py-8 text-center">
    <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl">
      Qué leen los grandes referentes del mundo
    </h1>
    <p class="mx-auto mt-3 max-w-2xl text-slate-600">
      Listas y reseñas de los libros recomendados por Bill Gates, Barack Obama, Warren
      Buffett y más. Encontrá tu próxima lectura entre las elecciones de las mentes más
      influyentes.
    </p>
  </section>

  <section class="mt-8">
    <h2 class="mb-4 text-xl font-bold text-slate-800">Referentes</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
      {
        autores.map((a) => (
          <a
            href={`/autores/${a.id}`}
            class="rounded-xl border border-slate-200 p-4 text-center transition hover:border-[var(--brand)] hover:shadow-sm"
          >
            <p class="font-semibold text-slate-800">{a.data.nombre}</p>
            <p class="text-xs text-slate-500">{a.data.profesion}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-12">
    <h2 class="mb-4 text-xl font-bold text-slate-800">Libros destacados</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        librosDestacados.map((l) => (
          <CardLibro
            slug={l.id}
            titulo={l.data.titulo}
            autorLibro={l.data.autorLibro}
            portada={l.data.portada}
            resumen={l.data.resumen}
          />
        ))
      }
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="mt-12">
        <h2 class="mb-4 text-xl font-bold text-slate-800">Del blog</h2>
        <ul class="space-y-3">
          {posts.map((p) => (
            <li>
              <a href={`/blog/${p.id}`} class="font-medium text-[var(--brand)] hover:underline">
                {p.data.titulo}
              </a>
              <p class="text-sm text-slate-500">{p.data.descripcion}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
