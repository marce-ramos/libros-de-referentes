---
// 404.astro — página de error del sitio.
//
// NO BORRAR ESTE ARCHIVO.
//
// Su sola existencia es lo que hace que Astro genere `dist/404.html`, y eso es
// lo que hace que Cloudflare Pages devuelva un código HTTP 404 real en cualquier
// URL que no exista. Sin este archivo, Cloudflare respondía 200 en URLs
// inexistentes ("soft 404"): Google las trataba como contenido válido y las
// indexaba, inflando el sitio con páginas basura infinitas.
//
// Detectado el 2026-08-22 con check-urls.ps1, que incluye tres casos que piden
// URLs inventadas y exigen 404. Correr ese script después de cada deploy.
import BaseLayout from "@/layouts/BaseLayout.astro";

const secciones = [
  {
    href: "/mas-recomendados",
    label: "Más recomendados",
    desc: "Los libros que más referentes repiten.",
  },
  {
    href: "/referentes",
    label: "Referentes",
    desc: "Todas las personas cuyas lecturas seguimos.",
  },
  {
    href: "/categorias",
    label: "Categorías",
    desc: "Historia, negocios, ciencia, ficción y más.",
  },
  {
    href: "/blog",
    label: "Blog",
    desc: "Las listas completas, referente por referente.",
  },
];
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscás no existe o cambió de dirección."
>
  <div class="py-6">
    <p class="text-sm font-semibold tracking-wide text-[var(--brand)]">Error 404</p>

    <h1
      class="mt-2 text-3xl font-bold text-slate-900"
      style="font-family: var(--serif)"
    >
      Esta página no existe
    </h1>

    <p class="mt-3 max-w-xl text-slate-600">
      Puede que el enlace esté mal escrito o que la página haya cambiado de
      dirección. Probá desde alguna de estas secciones:
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        secciones.map((s) => (
          <a
            href={s.href}
            class="rounded-xl border border-slate-200 p-4 transition hover:border-[var(--brand)] hover:shadow-sm"
          >
            <p class="font-semibold text-slate-800">{s.label}</p>
            <p class="mt-1 text-sm text-slate-500">{s.desc}</p>
          </a>
        ))
      }
    </div>

    <p class="mt-8 text-sm text-slate-500">
      O volvé a la <a
        href="/"
        class="font-semibold text-[var(--brand)] hover:underline">portada</a
      >.
    </p>
  </div>
</BaseLayout>
