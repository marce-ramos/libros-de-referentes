---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TarjetaRecomendado from "@/components/TarjetaRecomendado.astro";
import { SITE } from "@/config";
import { schemaItemList, schemaBreadcrumb } from "@/lib/schema";

const libros = await getCollection("libros");
const autores = await getCollection("autores");
const nombreDe = new Map(autores.map((a) => [a.id, a.data.nombre]));

function recomendadores(l: (typeof libros)[number]): string[] {
  return l.data.recomendadoPor.map((r) => nombreDe.get(r.id) ?? r.id);
}
function fmtNombres(ns: string[]): string {
  if (ns.length === 1) return ns[0];
  if (ns.length === 2) return `${ns[0]} y ${ns[1]}`;
  return `${ns[0]}, ${ns[1]} y ${ns.length - 2} más`;
}

const norm = (s: string) =>
  s.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase();

const masRecomendados = libros
  .filter((l) => l.data.recomendadoPor.length >= 2)
  .sort(
    (a, b) =>
      b.data.recomendadoPor.length - a.data.recomendadoPor.length ||
      Number(!!b.data.asin) - Number(!!a.data.asin) ||
      a.data.titulo.localeCompare(b.data.titulo),
  );

// Tramos por cantidad de referentes (de mayor a menor).
const counts = [...new Set(masRecomendados.map((l) => l.data.recomendadoPor.length))].sort(
  (a, b) => b - a,
);
const tramos = counts.map((c) => ({
  c,
  libros: masRecomendados.filter((l) => l.data.recomendadoPor.length === c),
}));

// Paginado progresivo por tramo (todo el HTML se renderiza; el resto se revela con JS).
const PAGE_SIZE = 6;

const url = new URL("/mas-recomendados", SITE.url).href;
const jsonLd = [
  schemaItemList({
    nombre: "Los libros más recomendados por los grandes referentes",
    items: masRecomendados.map((l) => ({
      url: new URL(`/libros/${l.id}`, SITE.url).href,
      nombre: l.data.titulo,
    })),
  }),
  schemaBreadcrumb([
    { nombre: "Inicio", url: SITE.url },
    { nombre: "Los más recomendados", url },
  ]),
];
---

<BaseLayout
  title="Los libros más recomendados por los grandes referentes"
  description="El ranking de los libros en los que coinciden más referentes mundiales: los que recomiendan Bill Gates, Barack Obama, Warren Buffett, Elon Musk y más."
  jsonLd={jsonLd}
>
  <nav class="mb-4 text-sm text-[var(--muted)]">
    <a href="/" class="hover:underline">Inicio</a> · Los más recomendados
  </nav>

  <h1 class="text-3xl font-bold text-[var(--brand-ink)]">Los libros más recomendados</h1>
  <p class="mt-2 max-w-2xl text-[var(--muted)]">
    El ranking de los libros en los que coinciden varios referentes del mundo. Cuantos más los
    eligen, más arriba: cuando dos o más de las mentes más influyentes recomiendan el mismo
    libro, hay una buena razón para prestarle atención.
  </p>

  <input
    id="buscador-mr"
    type="search"
    placeholder="Buscar por título o autor…"
    autocomplete="off"
    class="mt-6 w-full max-w-md rounded-lg border border-[var(--card-border)] bg-white px-4 py-2.5 text-sm outline-none focus:border-[var(--brand)]"
  />

  <p id="mr-sin-resultados" class="mt-6 hidden text-[var(--muted)]">
    No encontramos libros con esa búsqueda.
  </p>

  {
    tramos.map((t) => (
      <section class="mt-10" data-tramo>
        <h2 class="mb-5 text-xl font-bold text-[var(--brand-ink)]">
          Recomendados por {t.c} referentes
          <span class="ml-1 font-medium text-[var(--muted)]">({t.libros.length})</span>
        </h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {t.libros.map((l, i) => (
            <div
              class:list={["mr-item h-full", { hidden: i >= PAGE_SIZE }]}
              data-paged={i >= PAGE_SIZE ? "" : undefined}
              data-buscar={norm(`${l.data.titulo} ${l.data.autorLibro}`)}
            >
              <TarjetaRecomendado
                id={l.id}
                titulo={l.data.titulo}
                autorLibro={l.data.autorLibro}
                portada={l.data.portada}
                count={l.data.recomendadoPor.length}
                recomendadores={fmtNombres(recomendadores(l))}
              />
            </div>
          ))}
        </div>
        {t.libros.length > PAGE_SIZE && (
          <div class="mt-5 text-center">
            <button
              type="button"
              data-vermas
              class="inline-block rounded-lg border border-[var(--brand)] px-5 py-2.5 text-sm font-semibold text-[var(--brand)] transition hover:bg-[var(--brand)] hover:text-white"
            >
              Ver más
            </button>
          </div>
        )}
      </section>
    ))
  }
</BaseLayout>

<script>
  const STEP = 6;
  const norm = (s: string) =>
    s.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase();

  const secciones = Array.from(document.querySelectorAll<HTMLElement>("[data-tramo]"));
  const botones = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-vermas]"));
  const items = Array.from(document.querySelectorAll<HTMLElement>(".mr-item"));
  const input = document.getElementById("buscador-mr") as HTMLInputElement | null;
  const sinRes = document.getElementById("mr-sin-resultados");

  // Etiqueta de "Ver más" según cuántas tarjetas quedan ocultas por paginado (data-paged).
  const restantes = (sec: Element) => sec.querySelectorAll(".mr-item[data-paged]").length;
  const actualizarBoton = (btn: HTMLButtonElement) => {
    const sec = btn.closest("[data-tramo]");
    if (!sec) return;
    const n = restantes(sec);
    btn.classList.toggle("hidden", n === 0);
    if (n > 0) btn.textContent = `Ver más (${n} restantes)`;
  };

  // Paginado: revela de a STEP y limpia el marcador data-paged.
  botones.forEach((btn) => {
    const sec = btn.closest("[data-tramo]");
    if (!sec) return;
    actualizarBoton(btn);
    btn.addEventListener("click", () => {
      Array.from(sec.querySelectorAll<HTMLElement>(".mr-item[data-paged]"))
        .slice(0, STEP)
        .forEach((el) => {
          el.classList.remove("hidden");
          el.removeAttribute("data-paged");
        });
      actualizarBoton(btn);
    });
  });

  // Buscador: en modo búsqueda ignora el paginado; al vaciar, restaura el estado paginado.
  if (input) {
    input.addEventListener("input", () => {
      const q = norm(input.value.trim());
      if (!q) {
        items.forEach((it) => it.classList.toggle("hidden", it.hasAttribute("data-paged")));
        secciones.forEach((s) => s.classList.remove("hidden"));
        botones.forEach(actualizarBoton);
        sinRes?.classList.add("hidden");
        return;
      }
      let total = 0;
      items.forEach((it) => {
        const match = (it.dataset.buscar ?? "").includes(q);
        it.classList.toggle("hidden", !match);
        if (match) total++;
      });
      botones.forEach((b) => b.classList.add("hidden"));
      secciones.forEach((s) =>
        s.classList.toggle("hidden", !s.querySelector(".mr-item:not(.hidden)")),
      );
      sinRes?.classList.toggle("hidden", total > 0);
    });
  }
</script>
