---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
---

<BaseLayout
  title="Blog"
  description="Artículos y listas sobre los libros que recomiendan los grandes referentes del mundo."
>
  <h1 class="text-2xl font-bold text-slate-900">Blog</h1>

  <ul class="mt-6 space-y-6">
    {
      posts.map((p) => (
        <li class="border-b border-slate-100 pb-5">
          <a href={`/blog/${p.id}`} class="text-lg font-semibold text-[var(--brand)] hover:underline">
            {p.data.titulo}
          </a>
          <p class="mt-1 text-slate-600">{p.data.descripcion}</p>
          <p class="mt-1 text-xs text-slate-400">{p.data.fecha.toLocaleDateString("es-AR")}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
