---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/config";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);

const url = new URL(`/blog/${post.id}`, SITE.url).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: d.titulo,
    description: d.descripcion,
    datePublished: d.fecha.toISOString(),
    dateModified: (d.fechaActualizado ?? d.fecha).toISOString(),
    author: { "@type": "Organization", name: d.autor },
    mainEntityOfPage: url,
  },
];
---

<BaseLayout title={d.titulo} description={d.descripcion} type="article" jsonLd={jsonLd}>
  <article>
    <h1 class="text-3xl font-bold text-slate-900">{d.titulo}</h1>
    <p class="mt-2 text-sm text-slate-500">
      Publicado el {d.fecha.toLocaleDateString("es-AR")}
      {
        d.fechaActualizado &&
          ` · Actualizado el ${d.fechaActualizado.toLocaleDateString("es-AR")}`
      }
    </p>
    <div class="prose-contenido mt-6 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
