---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import EstanteLibros from "@/components/EstanteLibros.astro";
import { SITE } from "@/config";
import { schemaItemList, schemaBreadcrumb } from "@/lib/schema";

export async function getStaticPaths() {
  const autores = await getCollection("autores");
  const libros = await getCollection("libros");

  return autores.map((autor) => {
    // Libros donde este referente aparece en `recomendadoPor` (relación M:N).
    const recomendados = libros.filter((l) =>
      l.data.recomendadoPor.some((ref) => ref.id === autor.id),
    );
    return {
      params: { slug: autor.id },
      props: { autor, recomendados },
    };
  });
}

const { autor, recomendados } = Astro.props;
const d = autor.data;
const { Content } = await render(autor);

const url = new URL(`/autores/${autor.id}`, SITE.url).href;
const jsonLd = [
  schemaItemList({
    nombre: `Libros recomendados por ${d.nombre}`,
    items: recomendados.map((l) => ({
      url: new URL(`/libros/${l.id}`, SITE.url).href,
      nombre: l.data.titulo,
    })),
  }),
  schemaBreadcrumb([
    { nombre: "Inicio", url: SITE.url },
    { nombre: "Referentes", url: new URL("/autores", SITE.url).href },
    { nombre: d.nombre, url },
  ]),
];
---

<BaseLayout
  title={`Libros que recomienda ${d.nombre}`}
  description={`Todos los libros recomendados por ${d.nombre}: ${d.profesion}. ${d.bio}`}
  jsonLd={jsonLd}
>
  <header class="flex items-center gap-4">
    {
      d.foto && (
        <img src={d.foto} alt={d.nombre} class="h-20 w-20 rounded-full object-cover" />
      )
    }
    <div>
      <h1 class="text-2xl font-bold text-slate-900">
        Libros que recomienda {d.nombre}
      </h1>
      <p class="text-slate-500">{d.profesion}</p>
    </div>
  </header>

  <div class="prose-contenido mt-4 max-w-none">
    <Content />
  </div>

  <h2 class="mt-8 mb-5 text-xl font-bold text-[var(--brand-ink)]">
    Sus recomendaciones ({recomendados.length})
  </h2>
  <EstanteLibros libros={recomendados} />
</BaseLayout>
