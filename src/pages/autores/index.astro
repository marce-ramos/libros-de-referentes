---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const autores = (await getCollection("autores")).sort(
  (a, b) => a.data.orden - b.data.orden,
);
---

<BaseLayout
  title="Referentes"
  description="Todos los referentes mundiales cuyas recomendaciones de libros encontrás en el sitio."
>
  <h1 class="text-2xl font-bold text-slate-900">Referentes</h1>
  <p class="mt-2 text-slate-600">Elegí un referente para ver los libros que recomienda.</p>

  <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
    {
      autores.map((a) => (
        <a
          href={`/autores/${a.id}`}
          class="rounded-xl border border-slate-200 p-4 text-center transition hover:border-[var(--brand)] hover:shadow-sm"
        >
          <p class="font-semibold text-slate-800">{a.data.nombre}</p>
          <p class="text-xs text-slate-500">{a.data.profesion}</p>
        </a>
      ))
    }
  </div>
</BaseLayout>
