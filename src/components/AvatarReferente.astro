---
/**
 * Avatar de referente. Si hay `foto`, la muestra redonda; si no, un monograma
 * (iniciales sobre un círculo de color derivado del nombre). Cero riesgo legal,
 * consistente y con fallback automático. Reemplazá por foto (Wikimedia CC, con
 * atribución) cuando la consigas — solo hay que setear `foto` en el autor.
 */
interface Props {
  nombre: string;
  foto?: string;
  size?: "sm" | "lg";
}

const { nombre, foto, size = "sm" } = Astro.props;

const palabras = nombre.trim().split(/\s+/).filter(Boolean);
const iniciales = (
  palabras.length === 1
    ? palabras[0].slice(0, 2)
    : palabras[0][0] + palabras[palabras.length - 1][0]
).toUpperCase();

const paleta = [
  "#6c5ce7", "#2f6e63", "#2b3a67", "#7c3a2d", "#5a4a86", "#3b6b4a", "#8a6d1f",
  "#1f4e5f", "#6d2f4a", "#2d4b7a", "#b5642f", "#3f5aa6", "#5c3a6e",
];
let h = 0;
for (const c of nombre) h = (h + c.charCodeAt(0)) % paleta.length;
const bg = paleta[h];

const dim = size === "lg" ? "h-20 w-20 text-2xl" : "h-16 w-16 text-xl";
---

{
  foto ? (
    <img src={foto} alt={nombre} class={`${dim} shrink-0 rounded-full object-cover`} />
  ) : (
    <span
      class={`${dim} flex shrink-0 items-center justify-center rounded-full font-semibold text-white shadow-sm`}
      style={`background:${bg}`}
      aria-hidden="true"
    >
      {iniciales}
    </span>
  )
}
