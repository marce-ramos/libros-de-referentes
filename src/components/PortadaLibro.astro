---
/**
 * Portada del libro. Si hay imagen (`portada`), la muestra; si no, un
 * placeholder estilo "lomo de libro" que muestra el título.
 * El autor y el marcador de consenso viven en la etiqueta de abajo
 * (ver LibroEstante), no acá.
 */
interface Props {
  portada?: string;
  titulo: string;
  autorLibro: string;
  size?: "card" | "feat" | "full" | "shelf";
  /** Mostrar el título sobre el lomo del placeholder. false cuando el título
   *  ya se muestra al lado (evita duplicar). */
  showTitle?: boolean;
}

const { portada, titulo, autorLibro, size = "card", showTitle = true } = Astro.props;

const paleta = [
  "#2f6e63", "#2b3a67", "#7c3a2d", "#5a4a86", "#3b6b4a", "#8a6d1f", "#1f4e5f",
  "#6d2f4a", "#394a2f", "#2d4b7a", "#b5642f", "#3f5aa6", "#5c3a6e",
];
let h = 0;
for (const c of titulo) h = (h + c.charCodeAt(0)) % paleta.length;
const bg = paleta[h];

const dims: Record<string, string> = {
  card: "h-28 w-20 shrink-0",
  feat: "h-[152px] w-[104px] shrink-0",
  full: "w-full aspect-[2/3]",
  shelf: "h-[128px] w-[86px] shrink-0",
};
const pad = size === "full" ? "p-4" : size === "feat" ? "p-3" : "p-2.5";
const titleSize =
  size === "full"
    ? "text-lg"
    : size === "feat"
      ? "text-[15px]"
      : size === "shelf"
        ? "text-[13px]"
        : "text-[11px]";
---

{
  portada ? (
    <img
      src={portada}
      alt={`Portada de ${titulo}`}
      loading="lazy"
      class={`${dims[size]} rounded-[3px] object-cover shadow-[2px_3px_10px_rgba(40,30,80,0.22)]`}
    />
  ) : (
    <div
      class={`cover-ph ${dims[size]} ${pad}`}
      style={`background:${bg}`}
      aria-label={`Portada de ${titulo}`}
    >
      {showTitle && <b class={`${titleSize} break-words hyphens-auto line-clamp-5`}>{titulo}</b>}
      <span class="sr-only">{titulo} — {autorLibro}</span>
    </div>
  )
}
