---
import PortadaLibro from "@/components/PortadaLibro.astro";

interface Props {
  slug: string;
  titulo: string;
  autorLibro: string;
  portada?: string;
  resumen?: string;
}

const { slug, titulo, autorLibro, portada, resumen } = Astro.props;
---

<a
  href={`/libros/${slug}`}
  class="card-lift group flex gap-4 rounded-[14px] border border-[var(--card-border)] bg-white p-4 shadow-[0_4px_16px_rgba(90,70,160,0.05)] transition hover:border-[var(--brand)] hover:shadow-[0_10px_26px_rgba(90,70,160,0.13)]"
>
  <PortadaLibro portada={portada} titulo={titulo} autorLibro={autorLibro} size="card" />
  <div class="min-w-0">
    <h3 class="font-semibold text-[var(--brand-ink)] group-hover:text-[var(--brand)]">{titulo}</h3>
    <p class="text-sm text-[var(--muted)]">{autorLibro}</p>
    {resumen && <p class="mt-1 line-clamp-3 text-sm text-slate-600">{resumen}</p>}
  </div>
</a>
