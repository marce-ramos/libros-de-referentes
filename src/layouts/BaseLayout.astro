---
import { SITE } from "@/config";
import Seo from "@/components/Seo.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  jsonLd?: Record<string, unknown>[];
  /** Si es true, el <main> no aplica contenedor (para páginas con hero full-width como la home). */
  bare?: boolean;
}

const { title, description, image, type, jsonLd, bare = false } = Astro.props;
const year = new Date().getFullYear();

const nav = [
  { href: "/mas-recomendados", label: "Más recomendados" },
  { href: "/referentes", label: "Referentes" },
  { href: "/categorias", label: "Categorías" },
  { href: "/blog", label: "Blog" },
];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <Seo title={title} description={description} image={image} type={type} jsonLd={jsonLd} />
  </head>
  <body class="min-h-screen">
    <header class="relative border-b border-[var(--card-border)] bg-white/70 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
        <a
          href="/"
          class="flex items-center gap-2 text-xl font-bold text-[var(--brand-dark)]"
          style="font-family: var(--serif)"
        >
          <span class="inline-block h-4 w-4 rounded-full bg-[var(--brand)]"></span>
          {SITE.name}
        </a>

        {/* Nav de escritorio: oculto por debajo de md para evitar overflow horizontal en mobile */}
        <nav class="hidden items-center gap-6 text-sm text-[var(--muted)] md:flex">
          {nav.map((i) => <a href={i.href} class="hover:text-[var(--brand)]">{i.label}</a>)}
          <a
            href="/referentes"
            class="rounded-lg bg-[var(--brand)] px-4 py-2 font-semibold text-white hover:bg-[var(--brand-dark)]"
          >
            Explorar
          </a>
        </nav>

        {/* Toggle mobile (checkbox CSS-only, sin JS) */}
        <input type="checkbox" id="nav-toggle" class="peer hidden" />
        <label
          for="nav-toggle"
          class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border border-[var(--card-border)] text-[var(--brand-dark)] md:hidden"
          aria-label="Abrir menú"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </label>

        {/* Panel mobile: aparece cuando el checkbox está marcado */}
        <nav
          class="absolute inset-x-0 top-full hidden flex-col gap-1 border-b border-[var(--card-border)] bg-white px-4 py-3 text-sm text-[var(--muted)] shadow-lg peer-checked:flex md:hidden"
        >
          {nav.map((i) => (
            <a href={i.href} class="rounded-lg px-2 py-2 hover:bg-[#f6f3fd] hover:text-[var(--brand)]">
              {i.label}
            </a>
          ))}
          <a
            href="/referentes"
            class="mt-1 rounded-lg bg-[var(--brand)] px-4 py-2 text-center font-semibold text-white hover:bg-[var(--brand-dark)]"
          >
            Explorar
          </a>
        </nav>
      </div>
    </header>

    <main class={bare ? "" : "mx-auto max-w-5xl px-4 py-8"}>
      <slot />
    </main>

    <footer class="mt-16 border-t border-[var(--card-border)] bg-[#f6f3fd]">
      <div class="mx-auto max-w-5xl px-4 py-8 text-sm text-[var(--muted)]">
        <nav class="mb-5 flex flex-wrap gap-x-6 gap-y-2">
          {nav.map((i) => <a href={i.href} class="hover:text-[var(--brand)]">{i.label}</a>)}
        </nav>
        <p class="mb-2">
          <strong class="text-[var(--brand-dark)]">Aviso de afiliados:</strong> Como Afiliado de
          Amazon, gano por las compras adscritas. Esto no representa ningún costo extra para vos.
        </p>
        <p>© {year} {SITE.name}. Todos los derechos reservados.</p>
      </div>
    </footer>
  </body>
</html>
